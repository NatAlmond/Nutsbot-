# === Wajib / Sangat Disarankan ===
# Nomor owner bot (tanpa +)
OWNER_NUMBER=6281234567890

# Nomor yang akan dipakai sebagai bot (untuk Pairing Code). Kosongkan jika mau pakai QR.
PAIRING_NUMBER=628xxxxxxxxxx

# Prefix perintah
PREFIX=.

# Nama bot
BOT_NAME=Nuts

# === API Keys (isi yang dipakai) ===
GROQ_API_KEY=
GEMINI_API_KEY=

# Model default (opsional)
DEFAULT_AI=groq
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash

# === Limit harian per user ===
LIMIT_DOWNLOAD=5
LIMIT_AI=15
LIMIT_GAME=10

# Timezone
TIMEZONE=Asia/Jakarta
